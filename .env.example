# =============================================================================
# DR Command Center — environment contract
# =============================================================================
# Copy to `.env` (git-ignored) and fill in secrets. Every variable the stack
# reads is listed here. Non-secrets carry working local defaults; secrets are
# blank and MUST stay blank in this file (SECURITY_REVIEW.md §10).
#
# Precedence: FREEZE_ADDENDUM.md (D-2nn) > FROZEN_DECISIONS.md > companions.
# Values below are the local MacBook/Docker Compose profile (D-217, D-248).
# In Azure every secret is a Key Vault reference injected by Container Apps
# (infra/BICEP_PLAN.md); nothing below is read from a file in the cloud.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# local | dev | test | prod — selects cookie Secure flag, CORS allowlist, log format.
DRCC_ENV=local
# Tenant binding for encrypted packages (D-230). Locally any stable GUID; in Azure
# this MUST equal the Entra tenant GUID. Cross-tenant package import is rejected.
DRCC_TENANT_ID=00000000-0000-0000-0000-000000000001
API_PORT=8000
WEB_PORT=3000
# Next.js proxies same-origin /api -> FastAPI (D-239). Do not point the browser
# at the API port directly; the session cookie is same-origin only.
NEXT_PUBLIC_API_BASE=/api
# Internal URL the Next.js server/rewrite uses to reach FastAPI.
API_INTERNAL_URL=http://localhost:8000
# Explicit CORS allowlist (comma-separated). No wildcard in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secrets: generate with `openssl rand -hex 32`. Required; app refuses to start if empty.
SESSION_SECRET=
CSRF_SECRET=
# Local/dev package DEK-wrapping key (D-230): 32 bytes, base64. Prod uses a Key Vault key.
DRCC_PACKAGE_DEV_KEY=
# Session policy (D-235). Seconds.
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
REAUTH_WINDOW_SECONDS=300
# Local-account lockout (D-235).
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30
# Idempotency-Key retention (D-215, FROZEN §16.6). Hours.
IDEMPOTENCY_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector) — D-247
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://drcc:drcc@localhost:5432/drcc
# Read-only role for dashboards/reporting tooling. Role created by
# infra/docker/postgres-init/01-extensions.sql; password from POSTGRES_RO_PASSWORD.
DATABASE_URL_RO=postgresql+psycopg://drcc_readonly:drcc_ro@localhost:5432/drcc
POSTGRES_USER=drcc
POSTGRES_PASSWORD=drcc
POSTGRES_DB=drcc
POSTGRES_RO_PASSWORD=drcc_ro
# `test` compose profile (docker-compose.yml) — used by testcontainers fallback / CI.
TEST_DATABASE_URL=postgresql+psycopg://drcc:drcc@localhost:5433/drcc_test

# -----------------------------------------------------------------------------
# Redis / Celery — D-241, D-242
# -----------------------------------------------------------------------------
# One logical database everywhere: Azure Managed Redis (Enterprise cluster policy)
# exposes only DB 0, so sessions, broker, results and pub/sub share DB 0 and are
# separated by key prefix (drcc:sess:, celery:, drcc.rt.*). Never rely on DB numbers.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Pub/sub channel prefix for the transactional-outbox -> WebSocket backplane.
REALTIME_CHANNEL_PREFIX=drcc.rt
TEST_REDIS_URL=redis://localhost:6380/0

# -----------------------------------------------------------------------------
# Object storage — Azurite locally, Azure Blob in Azure (D-217)
# -----------------------------------------------------------------------------
# Well-known Azurite development account (public, not a secret).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# Azure only: when set, the adapter uses DefaultAzureCredential (managed identity)
# against this account URL and ignores the connection string (infra/BICEP_PLAN.md).
AZURE_STORAGE_ACCOUNT_URL=
BLOB_CONTAINER_EVIDENCE=evidence
BLOB_CONTAINER_DOCUMENTS=documents
BLOB_CONTAINER_PACKAGES=packages
# Seconds a time-limited read URL stays valid (SECURITY_REVIEW.md §6).
BLOB_SAS_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Email — Mailpit locally (D-256). Prod SMTP credentials live in Key Vault.
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=drcc-noreply@localhost
SMTP_FROM_NAME=DR Command Center
# Mailpit web UI (for tests/humans only).
MAILPIT_UI_URL=http://localhost:8025

# -----------------------------------------------------------------------------
# Identity — Entra ID OIDC via FastAPI + Local fallback (D-239, D-235)
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/v1/auth/entra/callback
# Local accounts are for testing/fallback; none are pre-created in prod (FROZEN §4.3).
AUTH_LOCAL_ENABLED=true
# TOTP is mandatory for Local GLOBAL_ADMIN (D-235); this flag controls other roles.
AUTH_LOCAL_TOTP_REQUIRED_ALL=false
# Path to newline-separated breached-password denylist (D-235). Empty = built-in small list.
AUTH_BREACHED_PASSWORD_LIST=
PASSWORD_RESET_TOKEN_MINUTES=30

# -----------------------------------------------------------------------------
# AI — provider-agnostic; environment opt-in; backend-only keys (D-249, FROZEN §11)
# -----------------------------------------------------------------------------
# Every critical workflow must pass with AI_ENABLED=false.
AI_ENABLED=false
# synthetic | anthropic  (Admin may change at runtime via /admin/ai; env is the seed)
AI_PROVIDER=synthetic
SYNTHETIC_API_KEY=
SYNTHETIC_BASE_URL=https://api.synthetic.new/v1
# Verified against the account at BUILD-16; never hard-code in domain code.
SYNTHETIC_MODEL=kimi-k3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Summaries feature flag (FROZEN §11.9).
AI_SUMMARIES_ENABLED=false
# CONSERVATIVE | BALANCED | FAST_EXECUTION — default control profile (D-225, D-228).
AI_CONTROL_PROFILE_DEFAULT=CONSERVATIVE
# Provider call timeout in seconds; on failure the UI shows AI-unavailable, never blocks DR.
AI_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Embeddings — sentence-transformers in the worker (D-233)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=nomic-embed-text-v1.5
EMBEDDING_DIM=768
# Local model cache directory (mounted into the worker container).
EMBEDDING_CACHE_DIR=.cache/embeddings

# -----------------------------------------------------------------------------
# Speech-to-text — faster-whisper in the worker (D-232)
# -----------------------------------------------------------------------------
SPEECH_PROVIDER=faster_whisper
WHISPER_MODEL=base
# cpu | cuda — Mac/POC uses cpu.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# -----------------------------------------------------------------------------
# Files / evidence security (D-225, SECURITY_REVIEW.md §6)
# -----------------------------------------------------------------------------
FILE_MAX_MB=100
FILE_ALLOWLIST=pdf,png,jpg,jpeg,txt,log,csv,xlsx,docx,zip,json
# mock | defender  — mock: EICAR payload -> INFECTED, else CLEAN (D-245)
MALWARE_SCANNER=mock
# Defender for Storage result delivery (Azure only): Event Grid -> this webhook.
MALWARE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Telemetry (OPERATIONS.md §Observability)
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=drcc-api
# Empty = exporter disabled locally. e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
# Azure only; injected from Key Vault by Container Apps.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Developer tooling (not read by the application)
# -----------------------------------------------------------------------------
# Playwright E2E base URL.
E2E_BASE_URL=http://localhost:3000
# k6 load-smoke target.
LOAD_BASE_URL=http://localhost:8000
